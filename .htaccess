# Que el navegador compruebe siempre si hay una versión nueva del código
# (si no ha cambiado, el servidor responde 304 y no se vuelve a descargar)
<IfModule mod_headers.c>
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Los sprites casi nunca cambian: se guardan una semana
    <FilesMatch "\.(png|svg)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Los módulos de JavaScript deben servirse como JavaScript
AddType text/javascript .js
